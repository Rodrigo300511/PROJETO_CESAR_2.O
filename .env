# ============================================================
# VARIÁVEIS DE AMBIENTE - ECOMETRIC
# ============================================================
# Este arquivo contém configurações sensíveis.
# NUNCA commitar este arquivo no Git (adicione à .gitignore)

# ============================================================
# MONGODB
# ============================================================
# Para desenvolvimento local, MongoDB roda em localhost:27017
# Se tiver MongoDB instalado e rodando, deixe como está.
# Se quiser usar MongoDB Atlas (nuvem), troque a URL.

MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=ecometric

# ============================================================
# AMBIENTE
# ============================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================================
# NOTA: Como este é um projeto de aprendizado,
# as credenciais são mínimas. Em produção, seria diferente.
# ============================================================